{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    // No baseUrl: it is deprecated, and its only other job here was letting
    // `types/*` and `styles/*` resolve as bare specifiers, which the explicit
    // mappings below now cover. Without baseUrl, paths resolve relative to
    // this file.
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@modules/*": ["./src/modules/*"],
      "types/*": ["./src/types/*"],
      "styles/*": ["./src/styles/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".nyc_output",
    "coverage",
    "jest-coverage"
  ]
}

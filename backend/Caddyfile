# Caddy provisions and renews the TLS certificate automatically; the only
# prerequisite is that BACKEND_DOMAIN's A record already points at this server.
{$BACKEND_DOMAIN} {
	encode gzip zstd

	# Product images are served from R2, not from here, so the only large bodies
	# reaching Medusa are admin uploads on their way through to R2.
	request_body {
		max_size 20MB
	}

	reverse_proxy {
		# Re-resolves Docker's DNS entry for `backend` on a timer instead of
		# once at startup. That is what makes `--scale backend=3` actually
		# spread traffic: without it Caddy would pin the first replica's IP and
		# the other two would sit idle.
		dynamic a {
			name backend
			port 9000
			refresh 10s
		}

		lb_policy least_conn
		health_uri /health
		health_interval 10s

		# Let a replica finish in-flight requests during a rolling restart
		# rather than failing the customer's checkout.
		fail_duration 30s
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

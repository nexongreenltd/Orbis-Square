# Copy to `.env` on the server and fill in. Never commit the filled version —
# `.env` is gitignored, this template is not.

# --- Domain -----------------------------------------------------------------
# Must already have an A record pointing at this server; Caddy needs it to
# issue the TLS certificate.
BACKEND_DOMAIN=api.orbissquare.com

# --- Database ---------------------------------------------------------------
POSTGRES_USER=medusa
POSTGRES_DB=medusa
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Secrets ----------------------------------------------------------------
# openssl rand -base64 32  (use a different value for each)
JWT_SECRET=
COOKIE_SECRET=

# --- CORS -------------------------------------------------------------------
# Your Vercel storefront origin. Add preview domains here too if you use them.
STORE_CORS=https://orbissquare.com,https://www.orbissquare.com
# The admin dashboard is served by the backend itself, so this is its own host.
ADMIN_CORS=https://api.orbissquare.com
AUTH_CORS=https://api.orbissquare.com,https://orbissquare.com,https://www.orbissquare.com

# --- Cloudflare R2 (file storage) -------------------------------------------
# From the R2 API token you create; endpoint is the account-level S3 API URL.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=orbissquare-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public read URL for the bucket — an r2.dev domain or your own CDN subdomain.
# This is what gets embedded in product image URLs, so prefer a custom domain.
S3_FILE_URL=https://media.orbissquare.com

# --- Backups ----------------------------------------------------------------
BACKUP_BUCKET=orbissquare-backups
RETENTION_DAYS=14

# --- PayPlus ----------------------------------------------------------------
PAYPLUS_BASE_URL=
PAYPLUS_MERCHANT_ID=
PAYPLUS_STORE_ID=
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_SANDBOX=false
